# ===================================================
# Production AI Job Search & Auto-Apply Agent
# Environment Configuration Template
# ===================================================

# Server & Network Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Persistent Storage
DATABASE_PATH=./server/data/job_finder.db
RESUME_STORAGE_PATH=./server/uploads/resumes

# Optional AI API Configuration
# If omitted or unconfigured, the system uses the built-in deterministic,
# zero-fabrication AI engine that guarantees truthful profile-derived application materials.
AI_PROVIDER=deterministic # Options: deterministic, openai, anthropic, gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Job Source API Credentials (Optional)
# Public feeds (Remotive, Arbeitnow, Jobicy) work without credentials.
# Adzuna requires registered credentials for their authorized free API tier.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in # e.g., in (India), us (United States), gb (United Kingdom)

# Platform Rate Limits & Safety Settings
LINKEDIN_DAILY_MAX_APPS=25
NAUKRI_DAILY_MAX_APPS=30
INDEED_DAILY_MAX_APPS=30
MIN_DELAY_SECONDS_BETWEEN_REQUESTS=5
MAX_DELAY_SECONDS_BETWEEN_REQUESTS=12

# Scheduled Search Configuration
DEFAULT_SEARCH_INTERVAL_HOURS=24
AUTO_SEARCH_ENABLED=false
